<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Orbit: third-party licenses</title>
<style>
body { font: 14px/1.5 -apple-system, sans-serif; max-width: 860px; margin: 2em auto; padding: 0 1em; }
pre { white-space: pre-wrap; background: #f4f4f4; padding: 1em; }
li { display: inline; } li:after { content: ", "; } li:last-child:after { content: ""; }
ul.licenses li { display: list-item; } ul.licenses li:after { content: ""; }
</style>
</head>
<body>
<h1>Third-party licenses</h1>
<p>Orbit is MIT licensed. It includes the following open source software.</p>
<h2>Overview</h2>
<ul class="licenses">
{{#each overview}}
  <li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
{{/each}}
</ul>
{{#each licenses}}
<h2 id="{{id}}">{{name}}</h2>
<p>Used by:</p>
<ul>
{{#each used_by}}
  <li><a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">{{crate.name}} {{crate.version}}</a></li>
{{/each}}
</ul>
<pre>{{text}}</pre>
{{/each}}
</body>
</html>
