# Copy to .env (gitignored). `make run` loads it and skips the Keychain.
# A key set here always wins over the one saved in the Keychain.

# Required. Linear > Settings > API > Personal API keys.
LINEAR_API_KEY=lin_api_...

# Optional. Short names, customers, the brief, the diff walkthrough.
# ANTHROPIC_API_KEY=sk-ant-...

# Optional. Diff tab without `gh auth login`.
# GITHUB_TOKEN=github_pat_...

# Optional. Skip the team picker: comma-separated team keys.
# ORBIT_TEAMS=DEV

# Optional. Keep test runs away from your real sessions and caches.
# ORBIT_DATA=target/dev-data
